# ---------- Database ----------
DATABASE_URL="postgresql://mizmar:mizmar@localhost:5433/mizmar?schema=public"

# ---------- Redis (BullMQ) ----------
REDIS_URL="redis://localhost:6380"

# ---------- API ----------
API_PORT=3001
API_HOST="0.0.0.0"
NODE_ENV="development"
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"

WEB_BASE_URL="http://localhost:3000"

# ---------- Object storage (SeaweedFS in dev, S3-compatible) ----------
S3_ENDPOINT="http://localhost:8333"
S3_REGION="us-east-1"
S3_ACCESS_KEY="mizmar"
S3_SECRET_KEY="mizmar-secret"
S3_BUCKET_ASSETS="mizmar-assets"
S3_BUCKET_DOCUMENTS="mizmar-documents"
S3_FORCE_PATH_STYLE="true"

# ---------- Mail (Mailpit in dev) ----------
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Mizmar <no-reply@mizmar.local>"

# ---------- WhatsApp (OpenWA gateway; leave empty to disable) ----------
# Create a session in the OpenWA dashboard, scan the QR from Settings > WhatsApp,
# then paste the API key and session id here.
OPENWA_URL="http://localhost:2785"
OPENWA_API_KEY=""
OPENWA_SESSION_ID=""

# ---------- Web ----------
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ---------- Mobile ----------
EXPO_PUBLIC_API_URL="http://localhost:3001"

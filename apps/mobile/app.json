{
  "expo": {
    "name": "Mizmar",
    "slug": "mizmar",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "mizmar",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ma.mizmar.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Scanner les codes-barres des articles pour consulter et ajuster le stock."
      }
    },
    "android": {
      "package": "ma.mizmar.app",
      "adaptiveIcon": { "backgroundColor": "#4F46E5" },
      "permissions": ["CAMERA"]
    },
    "web": { "bundler": "metro", "output": "static" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Scanner les codes-barres des articles pour consulter et ajuster le stock."
        }
      ]
    ],
    "experiments": { "typedRoutes": false }
  }
}

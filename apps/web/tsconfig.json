{
  "extends": "@mizmar/tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "*.ts",
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  // .next/types is a generated artifact that goes stale between a page being
  // added and the dev server regenerating it. `next build` validates routes
  // against a fresh copy, so standalone typecheck leaves it alone.
  "exclude": [
    "node_modules",
    ".next"
  ]
}

    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@mizmar/core": "workspace:*",
    "@ts-rest/core": "^3.51.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@mizmar/tsconfig": "workspace:*",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
